        hwIDCDULoadSettingMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                allBranch(1),
                singleBranch(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module load setting mode. It is an enumeration type:
                If the enumeration value is 1, it indicates that all branchs are setted totally; 
                If the enumeration value is 2, it indicates that every branch is setted seperately."
            ::= { hwSiteIDCDUSetEntry 1 }

        hwIDCDULvdMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                voltageMode(1),
                timeMode(2),
                capacityMode(3),
                consumptionMode(4),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module lvd mode. It is an enumeration type:
                If the enumeration value is 1, it indicates voltage mode; 
                If the enumeration value is 2, it indicates time mode.
                If the enumeration value is 3, it indicates capacity mode.
                If the enumeration value is 4, it indicates consumption mode.
                If the enumeration value is 255, it indicates unknown mode."
            ::= { hwSiteIDCDUSetEntry 2 }

        hwIDCDUTotalLoadLvdEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                no(1),
                yes(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module total load lvd enable or not. It is an enumeration type:
                If the enumeration value is 1, it indicates that lvd is enabled; 
                If the enumeration value is 2, it indicates that lvd is disenabled."
            ::= { hwSiteIDCDUSetEntry 3 }

        hwIDCDULoad1LvdEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                no(1),
                yes(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module load 1 lvd enable or not. It is an enumeration type:
                If the enumeration value is 1, it indicates that lvd is enabled; 
                If the enumeration value is 2, it indicates that lvd is disenabled."
            ::= { hwSiteIDCDUSetEntry 4 }

        hwIDCDULoad2LvdEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                no(1),
                yes(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module load 2 lvd enable or not. It is an enumeration type:
                If the enumeration value is 1, it indicates that lvd is enabled; 
                If the enumeration value is 2, it indicates that lvd is disenabled."
            ::= { hwSiteIDCDUSetEntry 5 }

        hwIDCDULoad3LvdEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                no(1),
                yes(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module load 3 lvd enable or not. It is an enumeration type:
                If the enumeration value is 1, it indicates that lvd is enabled; 
                If the enumeration value is 2, it indicates that lvd is disenabled."
            ::= { hwSiteIDCDUSetEntry 6 }

        hwIDCDULoad4LvdEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                no(1),
                yes(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Specific type of the IDCDU module load 4 lvd enable or not. It is an enumeration type:
                If the enumeration value is 1, it indicates that lvd is enabled; 
                If the enumeration value is 2, it indicates that lvd is disenabled."
            ::= { hwSiteIDCDUSetEntry 7 }

        hwIDCDUTotalLvdVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (360..560)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off voltage of the IDCDU unit can be configured by users. 
                Its value range: 360 to 560, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteIDCDUSetEntry 8 }

        hwIDCDULoad1LvdVoltage OBJECT-TYPE
            SYNTAX Integer32 (360..560)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off voltage of the IDCDU load1 unit can be configured by users. 
                Its value range: 36 to 56, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteIDCDUSetEntry 9 }

        hwIDCDULoad2LvdVoltage OBJECT-TYPE
            SYNTAX Integer32 (360..560)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "ow-voltage power-off voltage of the IDCDU load2 unit can be configured by users. 
                Its value range: 360 to 560, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteIDCDUSetEntry 10 }

        hwIDCDULoad3LvdVoltage OBJECT-TYPE
            SYNTAX Integer32 (360..560)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "ow-voltage power-off voltage of the IDCDU load3 unit can be configured by users. 
                Its value range: 360 to 560, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteIDCDUSetEntry 11 }

        hwIDCDULoad4LvdVoltage OBJECT-TYPE
            SYNTAX Integer32 (360..560)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "ow-voltage power-off voltage of the IDCDU load4 unit can be configured by users. 
                Its value range: 360 to 560, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteIDCDUSetEntry 12 }

        hwIDCDUTotalLvdReconVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (370..580)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off recover of the IDCDU unit can be configured by users. Its value range: 370 to 580, unit: V, and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: There is linkage between hwIDCDUTotalLvdVoltage and hwIDCDUTotalLvdReconVoltage"
            ::= { hwSiteIDCDUSetEntry 13 }

        hwIDCDULoad1LvdReconVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (370..580)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off recover of the IDCDU load1 unit can be configured by users. Its value range: 370 to 580, unit: V, and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: There is linkage between hwIDCDUTotalLvdVoltage and hwIDCDUTotalLvdReconVoltage"
            ::= { hwSiteIDCDUSetEntry 14 }

        hwIDCDULoad2LvdReconVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (370..580)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off recover of the IDCDU load2 unit can be configured by users. Its value range: 370 to 580, unit: V, and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: There is linkage between hwIDCDUTotalLvdVoltage and hwIDCDUTotalLvdReconVoltage"
            ::= { hwSiteIDCDUSetEntry 15 }

        hwIDCDULoad3LvdReconVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (370..580)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off recover of the IDCDU load3 unit can be configured by users. Its value range: 370 to 580, unit: V, and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: There is linkage between hwIDCDUTotalLvdVoltage and hwIDCDUTotalLvdReconVoltage"
            ::= { hwSiteIDCDUSetEntry 16 }

        hwIDCDULoad4LvdReconVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (370..580)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off recover of the IDCDU load4 unit can be configured by users. Its value range: 370 to 580, unit: V, and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: There is linkage between hwIDCDUTotalLvdVoltage and hwIDCDUTotalLvdReconVoltage"
            ::= { hwSiteIDCDUSetEntry 17 }

        hwIDCDUTotalLvdTime OBJECT-TYPE
            SYNTAX Integer32 (0..6000)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off disconnected time, It can be configured by users, and its value is an integer (1). 
                    Here, if lvd mode is time mode, value range defines between 0 to 6000, unit: minutes(min). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: Only the lvd in time power off mode, this parameter can be configured successfully."
            ::= { hwSiteIDCDUSetEntry 18 }

        hwIDCDULoad1LvdTime OBJECT-TYPE
            SYNTAX Integer32 (0..6000)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Low-voltage power-off load1 disconnected time, It can be configured by users, and its value is an integer (1). 
                    Here, if lvd mode is time mode, value range defines between 0 to 6000, unit: minutes(min). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid.
                NOTE: Only the lvd in time power off mode, this parameter can be configured successfully."
            ::= { hwSiteIDCDUSetEntry 19 }

