        hw3rdPartyBatIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery table index. Lines of the device list are restricted by the quantity of third-party lithium battery."
            ::= { hwThirdPartyLitBatSampEntry 1 }

        hw3rdPartyBatEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery device ID."
            ::= { hwThirdPartyLitBatSampEntry 2 }

        hw3rdPartyBatEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Equip name of third-party lithium battery."
            ::= { hwThirdPartyLitBatSampEntry 3 }

        hw3rdPartyBatEquipAddr OBJECT-TYPE
            SYNTAX Unsigned32 (0..255)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery equip address,lithium battery types include ZTT,ChinaShoto,Coslight. 
                Value range: 0 to 255."
            ::= { hwThirdPartyLitBatSampEntry 4 }

        hw3rdPartyBatVolt OBJECT-TYPE
            SYNTAX Unsigned32 (0..3000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery voltage,lithium battery types include ZTT,ChinaShoto,Coslight. 
                Value range: 0 to 300,unit: V"
            ::= { hwThirdPartyLitBatSampEntry 5 }

        hw3rdPartyBatCurr OBJECT-TYPE
            SYNTAX Integer32 (-30000..30000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery current,lithium battery types include ZTT,ChinaShoto,Coslight. 
                Value range: -3000 to 3000,unit: A"
            ::= { hwThirdPartyLitBatSampEntry 6 }

        hw3rdPartyBatStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                online(0),
                offline(1),
                hibernating(2),
                open(3),
                charge(4),
                discharge(5),
                standby(6),
                lowPower(7),
                protected(8),
                limitation(9),
                forbiddenCharge(10),
                regulatedCharge(11),
                float(12),
                nominal(13),
                safe(14),
                idle(15),
                fullyCharged(16),
                moduleFailureButInOperation(17),
                moduleOutOfOperation(18),
                chargeOnline(19),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery status,lithium battery types include ZTT,ChinaShoto,Coslight. 
                Online is 0, offline is 1, hibernating is 2, open is 3, charge is 4, discharge is 5, standby is 6, lowPower is 7, protected is 8, limitation is 9, forbiddenCharge is 10, regulatedCharge is 11, float is 12, nominal is 13, safe is 14, idle is 15, fullyCharged is 16, moduleFailureButInOperation is 17, moduleOutOfOperation is 18, chargeOnline is 19."
            ::= { hwThirdPartyLitBatSampEntry 7 }

        hw3rdPartyBatChgMosStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                close(1),
                open(2),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery charge MOS status,lithium battery types include ZTT. 
                Value range: close is 1, open is 2."
            ::= { hwThirdPartyLitBatSampEntry 8 }

        hw3rdPartyBatDischgMosStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                close(1),
                open(2),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
