            ::= { hwPowerControllerEquipSampEntry 44 }

        hwPowerControllerBatteryRatedCapacity  OBJECT-TYPE
            SYNTAX Unsigned32 (0..65535)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                " batteries rated capacity. It is an analog parameter collected by the battery string in real time.Value range: 0 to 65535, unit: Ah, the value is an integer (1). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPowerControllerEquipSampEntry 45 }

        hwPowerControllerBatteryManagementState  OBJECT-TYPE
            SYNTAX INTEGER
                {
                fcharging(1),
                bcharging(2),
                enforce(3),
                discharging(4),
                dormant(5),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "State of the battery management.It is an enumeration type:
                If the enumeration value is 1, it indicates that battery is on float charging,
                If the enumeration value is 2,it indicates that battery is on equal charging,
                If the enumeration value is 3, it indicates the battery is enforce on equal charging,
                If the enumeration value is 4, , it indicates that battery is on discharge,
                If the enumeration value is 5, it indicates  that battery dormant,
                  If the enumeration value is 255, that battery operation status unknown."
            ::= { hwPowerControllerEquipSampEntry 46 }

        hwPowerControllerSoftwareVersion  OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..60))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Monitor software version. It is of the character string type."
            ::= { hwPowerControllerEquipSampEntry 47 }

