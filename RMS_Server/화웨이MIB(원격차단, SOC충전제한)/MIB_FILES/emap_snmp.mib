            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Dc Ammeter name, of the character string type, is used to specify Dc Ammeter. Users can configure it.
                Otherwise, the configured character can not be any other languages except English."
            ::= { hwSiteDcAmmeterSampEntry 3 }

        hwDcAmmeterChannel1Voltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Dc Ammeter channel 1 voltage, 
                Value range: 0.00 to 100.00.
                Unit: V.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteDcAmmeterSampEntry 4 }

        hwDcAmmeterChannel1Current OBJECT-TYPE
            SYNTAX Integer32 ( -100000..100000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Dc Ammeter channel 1 current, 
                Value range: -1000.00. to 1000.00.
                Unit: A.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteDcAmmeterSampEntry 5 }

        hwDcAmmeterChannel1Power OBJECT-TYPE
            SYNTAX Integer32 ( -6000000..6000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
