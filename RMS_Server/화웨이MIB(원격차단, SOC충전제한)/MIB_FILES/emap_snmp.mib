                    Unsigned32,
                hwPVAdapterGroupCurrentMonthlyOutputPower
                    Unsigned32,
                hwPVAdapterGroupCurrentYearlyOutputPower
                    Unsigned32,
                hwPVAdapterGroupPVGroupLockEnableState
                    INTEGER
            }

        hwPVAdapterGroupIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter group table index. Lines of the device list are restricted by the quantity of PV Adapter group."
            ::= { hwPVAdapterGroupSampEntry 1 }

        hwPVAdapterGroupEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter group device ID."
            ::= { hwPVAdapterGroupSampEntry 2 }

        hwPVAdapterGroupEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter group name, of the character string type, is used to specify PV Adapter group.
                
                "
            ::= { hwPVAdapterGroupSampEntry 3 }

        hwPVAdapterGroupTotalOutCurr OBJECT-TYPE
            SYNTAX Unsigned32 (0..240000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter group total Output current, Value range: 0.0 to 24000.0.Unit: A.and the value is accurate to one decimal space (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 4 }

        hwPVAdapterGroupTotalOutPower OBJECT-TYPE
            SYNTAX Unsigned32 (0..4294967295)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The PV Adapter group total output power; 
                Value range: 0 to 4294967295, 
                and the value is accurate to two decimal place (.01), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 5 }

        hwPVAdapterGroupTotalInKW OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Total input power of the  PV Adapter group. Value range: 0 to 100000, unit: kW, and the value is accurate to two decimal place (.01). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 6 }

        hwPVAdapterGroupTotalOutKW OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Total output power of the PV Adapter group. Value range: 0 to 100000, unit: kW, and the value is accurate to two decimal place (.01). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 7 }

        hwPVAdapterGroupFoundNum OBJECT-TYPE
            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The found number in the PV Adapter group; 
                Value range: 0 to 100.   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 8 }

        hwPVAdapterGroupLocateStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                positioningSuccess(1),
                positioningFailed(2),
                notPosition(3),
                positioning(4),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Locate states of the PV Adapter group. It is an enumeration type: 
                  If the enumeration value is 1, it indicates that the PV Adapter positioning success;
                  If the enumeration value is 2, it indicates that the PV Adapter positioning failed.
                  If the enumeration value is 3, it indicates that the PV Adapter not position;
                  If the enumeration value is 4, it indicates that the PV Adapter is positioning;
                  If the enumeration value is 255, it indicates that the PV Adapter is in the unknown state."
            ::= { hwPVAdapterGroupSampEntry 9 }

        hwPVAdapterGroupRunStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                off(1),
                on(2),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Run states of the PV Adapter group. It is an enumeration type: 
                  If the enumeration value is 1, it indicates that the PV Adapter is off;
                  If the enumeration value is 2, it indicates that the PV Adapter is on;
                  If the enumeration value is 255, it indicates that the PV Adapter is in the unknown state."
            ::= { hwPVAdapterGroupSampEntry 10 }

        hwPVAdapterGroupCommFaultNum OBJECT-TYPE
            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The communication failed found number in the PV Adapter group; 
                Value range: 0 to 100.   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterGroupSampEntry 11 }

        hwPVAdapterGroupCurrentHourlyOutputPower OBJECT-TYPE
            SYNTAX Unsigned32 (0..4294967295)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The PV Optimizer group current hourly output power; 
                Value range: 0 to 4294967295, 
                and the value is accurate to two decimal place (.01)."
            ::= { hwPVAdapterGroupSampEntry 12 }

        hwPVAdapterGroupCurrentDayOutputPower OBJECT-TYPE
            SYNTAX Unsigned32 (0..4294967295)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The PV Optimizer group current-day output power; 
                Value range: 0 to 4294967295, 
                and the value is accurate to two decimal place (.01)."
            ::= { hwPVAdapterGroupSampEntry 13 }

        hwPVAdapterGroupCurrentWeeklyOutputPower OBJECT-TYPE
            SYNTAX Unsigned32 (0..4294967295)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The PV Optimizer group current weekly output power; 
                Value range: 0 to 4294967295, 
                and the value is accurate to two decimal place (.01)."
