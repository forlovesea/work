            SYNTAX INTEGER
                {
                clear(1)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Dc Ammeter clear communication failure . It is an enumeration type: 
                If the enumeration value is 1, it indicates that the Dc Ammeter clear communication failure alarm;"
            ::= { hwSiteDcAmmeterSetEntry 2 }

        hwDcAmmeterChannel1DetectionObject
 OBJECT-TYPE
            SYNTAX INTEGER
                {
                none(1),
                dcMainEquipment(2),
                dcTCEquipment(3),
                battery(4),
                dcOtherEquipment(5),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Detection object of the DC ammeter channel1. It is an enumeration type: 
                If the enumeration value is 1, it indicates that the object is none;
                If the enumeration value is 2, it indicates that the object is DC main equipment;; 
                If the enumeration value is 3, it indicates that the object is DCTC equipment;  
                If the enumeration value is 4, it indicates that the object is battery;  
                If the enumeration value is 5, it indicates that the object is DC other equipment;  
                If the enumeration value is 255, it indicates that the object is unknown."
            ::= { hwSiteDcAmmeterSetEntry 3 }

