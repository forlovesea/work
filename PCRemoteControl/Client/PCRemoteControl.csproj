<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <InformationalVersion>v0.2.1</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.17" />
  </ItemGroup>
  <ItemGroup Condition="'$(FFmpegNativeDir)' != ''">
    <NativeCopyLocalItems Include="$(FFmpegNativeDir)\*.dll">
      <CopyLocal>true</CopyLocal>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <AssetType>native</AssetType>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </NativeCopyLocalItems>
  </ItemGroup>
</Project>
