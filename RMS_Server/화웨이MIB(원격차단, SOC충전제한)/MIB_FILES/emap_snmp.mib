        hwAcAmmeterAcOvervoltageThreshold OBJECT-TYPE
            SYNTAX Unsigned32 (60..300)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Upper threshold of the AC voltage alarm, can be configued by users. 
                Value range: 60 to 300, 
                unit: V.  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. 
                The default value is 280. "
            ::= { hwSiteAcAmmeterEntry 40 }

        hwAcAmmeterAcUndervoltageThreshold OBJECT-TYPE
            SYNTAX Unsigned32 (60..300)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Lower threshold of the AC voltage alarm, can be configued by users. 
                Value range: 60 to 300, 
                unit: V.  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. 
                The default value is 180. "
            ::= { hwSiteAcAmmeterEntry 41 }

        hwAcAmmeterAcSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                other(1),
                mains(2),
                dg(3),
                mains2(4),
                dg2(5),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The AC source of the AC ammeter.It is an enumeration type: 
                If the enumeration value is 1, it indicates that the source is other;
                If the enumeration value is 2, it indicates that the source is mains; 
                If the enumeration value is 3, it indicates that the source is DG;
                If the equip is 5G customized ammeter and the enumeration value is 4, it indicates that the source is mains2; 
                If the equip is 5G custom ammeter and the enumeration value is 5, it indicates that the source is mains2; 
                If the enumeration value is 255, it indicates that the source is unknown.
                Only 5G customized ammeters allow users to get and set values 4 and 5."
            ::= { hwSiteAcAmmeterEntry 42 }

