        hwUserEquipmentSetPowerOffEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                disable(1),
                enable(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Power off enable switch of user equipment, It is an enumeration type: 
                If the enumeration value is 1, it indicates that the power off function disable;
                If the enumeration value is 2, it indicates that the power off function enable;"
            ::= { hwUserEquipmentSetEntry 3 }

        hwUserEquipmentSetLLVDMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                voltageMode(1),
                timeMode(2),
                capacityMode(3),
                powerMode(4),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "LLVD mode selection of user equipment, It is an enumeration type: 
                If the enumeration value is 1, it indicates that the voltage LLVD mode;
                If the enumeration value is 2, it indicates that the time LLVD mode;
                If the enumeration value is 3, it indicates that the capacity LLVD mode;
                If the enumeration value is 4, it indicates that the capacity power mode;"
            ::= { hwUserEquipmentSetEntry 4 }

        hwUserEquipmentSetLLVDVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (360..560)
            MAX-ACCESS read-write
