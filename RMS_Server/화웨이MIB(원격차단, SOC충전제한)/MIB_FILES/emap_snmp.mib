                    Unsigned32
            }

        hwIDCDUSampIndex OBJECT-TYPE
            SYNTAX Integer32 (1..256)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Table index of the running IDCDU modules, which value range: 1 to 256(To the actual subject). Lines of the device list are restricted by the total quantity of the IDCDU modules (hwDCDBTotalQuantity)."
            ::= { hwIDCDUSampEntry 1 }

        hwIDCDUEquipId OBJECT-TYPE
            SYNTAX Unsigned32 (1..255)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "IDCDU module ID. Value range: 002'001 to 002'255. The first digits indicate the device type and last three digits indicate the device SN."
            ::= { hwIDCDUSampEntry 2 }

        hwIDCDUEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Device name of the IDCDU module, character string type, is used to specify the IDCDU module. Users can configure it. 
                  Otherwise, the configured character can not be any other languages except English."
            ::= { hwIDCDUSampEntry 3 }

        hwIDCDUOutputVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Output voltage of the IDCDU module. It is a real-time analog parameter. Value range: 0 to 100.0, unit: V, the value is accurate to one decimal place (.1). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. "
            ::= { hwIDCDUSampEntry 4 }

        hwIDCDULoadNumber OBJECT-TYPE
            SYNTAX Unsigned32 (0..65535)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Total load number. Value range: 0 to 65535, unit: NA, and the value is an integer. If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwIDCDUSampEntry 5 }

        hwIDCDUTotalOutputCurrent OBJECT-TYPE
            SYNTAX Unsigned32 (0..300000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Total output current of the IDCDU module. It is a real-time analog parameter. Value range: 0.0 to 30000.0, unit: A, and the value is accurate to one decimal place (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwIDCDUSampEntry 6 }

        hwIDCDULoad1Current OBJECT-TYPE
            SYNTAX Unsigned32 (0..300000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Load 1 output current of the IDCDU module. It is a real-time analog parameter. Value range: 0 to 30000.0, unit: A, and the value is accurate to one decimal place (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwIDCDUSampEntry 7 }

        hwIDCDULoad2Current OBJECT-TYPE
            SYNTAX Unsigned32 (0..300000)
