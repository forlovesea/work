                    Unsigned32,
                hwIDCDULoadNumber
                    Unsigned32,
                hwIDCDUTotalOutputCurrent
                    Unsigned32,
                hwIDCDULoad1Current
                    Unsigned32,
                hwIDCDULoad2Current
                    Unsigned32,
                hwIDCDULoad3Current
                    Unsigned32,
                hwIDCDULoad4Current
                    Unsigned32,
                hwIDCDUTotalOutputPower
                    Unsigned32,
                hwIDCDULoad1Power
                    Unsigned32,
                hwIDCDULoad2Power
                    Unsigned32,
                hwIDCDULoad3Power
                    Unsigned32,
