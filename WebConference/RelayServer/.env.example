DOMAIN=meet.example.com
DB_PATH=/app/data/meetings.db
VOSK_MODEL_PATH=/app/models/vosk-model-small-ko-0.22
MAX_PARTICIPANTS=8
MAX_ROOMS=30
# Usually empty: clients open https://DOMAIN, which is same-origin.
# To host the settings page separately, list its origins (comma-separated).
ALLOWED_ORIGINS=
# For one LAN, [] works when the server UDP range is reachable.
ICE_SERVERS_JSON=[]
# Internet/NAT example. Configure matching credentials in deploy/turnserver.conf.
# ICE_SERVERS_JSON=[{"urls":"stun:meet.example.com:3478"},{"urls":"turn:meet.example.com:3478?transport=udp","username":"meeting","credential":"REPLACE_WITH_LONG_RANDOM_PASSWORD"}]
