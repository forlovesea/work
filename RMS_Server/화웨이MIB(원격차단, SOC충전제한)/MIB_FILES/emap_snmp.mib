        hwDcCabinetDcVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Bus voltage  of the Dc cabinet. 
                Its value range: 0 to 100, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwDcCabinetInfoEntry 4 }

        hwDcCabinetIndoorTemperature OBJECT-TYPE
            SYNTAX Integer32 ( -40..80)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The environment  temperature of Dc cabinet. It is a parameter collected in real time. 
                Value range: -40 to 80,
                unit: centigrade (degC), 
                and the value is an integer .
                If the value is 2147483647(0x7FFFFFFF), it indicates that battery temperature sensor is not configured."
            ::= { hwDcCabinetInfoEntry 5 }

        hwDcCabinetTotalLoadCurrent OBJECT-TYPE
            SYNTAX Unsigned32 (0..500000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Load current: 0 to 50000, 
                unit: A, 
                and the value is one decimal space (.1). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwDcCabinetInfoEntry 6 }

