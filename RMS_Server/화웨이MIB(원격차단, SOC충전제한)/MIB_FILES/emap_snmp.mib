            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Li Battery Cabinet equip name."
            ::= { hwLiBatteryCabinetInfoEntry 3 }

        hwLiBatteryCabinetBatteryTotalCurrent OBJECT-TYPE
            SYNTAX Integer32 ( -640000..640000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Li battery cabinet total current: -64000 to 64000, 
                unit: A, 
                and the value is one decimal space (.1). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwLiBatteryCabinetInfoEntry 4 }

        hwLiBatteryCabinetBMUTotalQuantity OBJECT-TYPE
            SYNTAX Unsigned32 (0..32)
            MAX-ACCESS read-only
