        hwIDCDUGroupId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Device group ID of the DCDB module. It is the unique ID of the rectifier module group, and its default value: 034,000. 
                  The first digits indicate the device type and the last three digits indicate the device SN. If the last three digits are 000, it indicates a virtual device. "
            ::= { hwIDCDUGroup 1 }

        hwIDCDUGroupName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Name of the DCDB module group, character string type, is used to specify the rectifier module group. Users can configure it. 
                  Otherwise, the configured character can not be any other languages except English."
            ::= { hwIDCDUGroup 2 }

        hwIDCDUTotalQuantity OBJECT-TYPE
            SYNTAX Unsigned32 (0..65535)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Total quantity of the DCDB modules. Value range: 0 to 65535. unit:pcs."
            ::= { hwIDCDUGroup 3 }

