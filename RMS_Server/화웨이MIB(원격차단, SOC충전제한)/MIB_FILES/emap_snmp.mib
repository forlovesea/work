        hwController OBJECT IDENTIFIER ::= { hwSiteMonitorMIBObjects 39 }

        hwControllerInfoTable OBJECT-TYPE
            SYNTAX SEQUENCE OF HwControllerInfoEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            ::= { hwController 1 }

        hwControllerInfoEntry OBJECT-TYPE
                        SYNTAX HwControllerInfoEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            INDEX { hwControllerIndex }
            ::= { hwControllerInfoTable 1 }

        HwControllerInfoEntry            ::= SEQUENCE {
                hwControllerIndex
                    Unsigned32,
                hwControllerEquipId
                    Unsigned32,
                hwControllerEquipName
                    OCTET STRING,
                hwControllerFatherEquipname
                    OCTET STRING,
                hwControllerBuzzerEnable
                    INTEGER,
                hwControllerType
                    INTEGER
            }

        hwControllerIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Controller Index."
            ::= { hwControllerInfoEntry 1 }

        hwControllerEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Controller equip ID no."
            ::= { hwControllerInfoEntry 2 }

        hwControllerEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Controller equip name."
            ::= { hwControllerInfoEntry 3 }

        hwControllerFatherEquipname OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Name of the parent device of the Water Sensor"
            ::= { hwControllerInfoEntry 4 }

        hwControllerBuzzerEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                enable(1),
                disable(2),
                nullOper(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Buzzer enabling. It manually controls the enabling of the buzzer alarm. This node is of the enumeration type. 
                When the enumeration value is 1, it means to enable the buzzer;
                When the enumeration value is 2, it means to disable the buzzer. 
                When the enumeration value is 255, it means to nulloper the buzzer. 
                "
            ::= { hwControllerInfoEntry 5 }

        hwControllerType OBJECT-TYPE
            SYNTAX INTEGER
                {
                smu02b(1),
                smu02c(2),
                smu02s(3),
                smu02d(4),
                smu11b(5),
                wcu01(6),
                smu02c_x(7),
                scc800_s(8),
                e_iot(9),
                smu06t2(10),
                smu02x_e(11),
                smu02c1(12),
                isitepower_m(13),
                smu11c(14),
                dps(15),
                smu11d(16),
                acb_iot(17),
                ibreaker(18),
                smu02c2(19),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Controller type.Value range: SMU02B is 0, SMU02C is 1, SMU02S is 2, SMU02D is 3, SMU11B is 4, WCU01 is 5, SMU02C_X is 6, SCC800_S is 7, E_IOT is 8, SMU06T2 is 9, SMU02X_E is 10, SMU02C1 is 11, ISITEPOWER_M is 12, SMU11C is 14, ACB_IOT is 19, IBREAKER is 20, SMU02C2 is 21."
            ::= { hwControllerInfoEntry 6 }

