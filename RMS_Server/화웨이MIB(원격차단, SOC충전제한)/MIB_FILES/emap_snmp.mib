        hwAcAmmeterChannel1DetectionObject OBJECT-TYPE
            SYNTAX INTEGER
                {
                none(1),
                acTotalInput(2),
                acMainEquipment(3),
                acTCEquipment(4),
                acOtherEquipment(5),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Detection object of the AC ammeter channel1. It is an enumeration type: 
                If the enumeration value is 1, it indicates that the object is none;
                If the enumeration value is 2, it indicates that the object is AC total input; 
                If the enumeration value is 3, it indicates that the object is AC main equipment;  
                If the enumeration value is 4, it indicates that the object is AC TC equipment;  
                If the enumeration value is 5, it indicates that the object is AC other equipment;  
                If the enumeration value is 255, it indicates that the object is unknown."
            ::= { hwSiteAcAmmeterEntry 36 }

