        hwHWInverterUnitOutputVoltageType OBJECT-TYPE
            SYNTAX INTEGER
                {
                voltage200(1),
                voltage208(2),
                voltage220(3),
                voltage230(4),
                voltage240(5),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Output voltage type of the inverter unit module. It is an enumeration type:
                If the enumeration value is 1, it indicates 200V; 
                If the enumeration value is 2, it indicates 208V;
                If the enumeration value is 3, it indicates 220V; 
                If the enumeration value is 4, it indicates 230V;
                If the enumeration value is 5, it indicates 240V;
                If the enumeration value is 255, it indicates unkown type."
            ::= { hwHWInverterUnitSetEntry 1 }

        hwHWInverterUnitOutputFrequency OBJECT-TYPE
            SYNTAX INTEGER
                {
                frequency50(1),
                frequency60(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Output frequency of the inverter unit module. It is an enumeration type:
                If the enumeration value is 1, it indicates 50 Hz; 
                If the enumeration value is 2, it indicates 60 Hz;
                If the enumeration value is 255, it indicates unkown type."
            ::= { hwHWInverterUnitSetEntry 2 }

        hwHWInverterUnitOutputMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                bypassFirst(1),
                invertFirst(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Output mode of the inverter unit module. It is an enumeration type:
                If the enumeration value is 1, it indicates BypassFirst; 
                If the enumeration value is 2, it indicates InvertFirst."
            ::= { hwHWInverterUnitSetEntry 4 }

        hwHWInverterUnitFanControlMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                auto(1),
                fullSpeed(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Fan control mode of the inverter unit module. It is an enumeration type:
                If the enumeration value is 1, it indicates Auto; 
                If the enumeration value is 2, it indicates Full Speed."
            ::= { hwHWInverterUnitSetEntry 6 }

        hwHWInverterUnitUpperInputProtectionVoltage  OBJECT-TYPE
            SYNTAX Integer32 (560..600)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Upper input protection voltage, It can be configured by users. 
                Its value range: 56 to 60, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 7 }

        hwHWInverterUnitLowerInputProtectionVoltage  OBJECT-TYPE
            SYNTAX Integer32 (410..480)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Lower input protection voltage, It can be configured by users. 
                Its value range: 41 to 48, 
                unit: V, 
                and the value is accurate to one decimal space (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 8 }

        hwHWInverterUnitUpperOutputProtectionVoltage  OBJECT-TYPE
            SYNTAX Integer32 (110..135)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Upper output protection voltage, It can be configured by users. 
                Its value range: 110 to 135, 
                unit: %, 
                and its value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 9 }

        hwHWInverterUnitLowerOutputProtectionVoltage  OBJECT-TYPE
            SYNTAX Integer32 (65..90)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Lower output protection voltage, It can be configured by users. 
                Its value range: 65 to 90, 
                unit: %, 
                and its value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 10 }

        hwHWInverterUnitFanSpeedControl OBJECT-TYPE
            SYNTAX Integer32 (1..100)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Fan speed control, It can be configured by users. 
                Its value range: 1 to 100, 
                unit: %, 
                and its value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 11 }

        hwHWInverterUnitDeleteCommunicationFailureEquip OBJECT-TYPE
            SYNTAX INTEGER
                {
                yes(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Delete communication failure equipments of the inverter unit module. It is an enumeration type:
                If the enumeration value is 2, it indicates that deletes communication failure equipments; "
            ::= { hwHWInverterUnitSetEntry 12 }

        hwHWInverterUnitLowerInputHysteresisVolt OBJECT-TYPE
            SYNTAX Unsigned32 (3..5)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Hysteresis point of the lower input voltage. 
                Its value range: 3 to 5, 
                unit: V, 
                and its value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 14 }

        hwHWInverterUnitCabinetNum OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..30))
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Cabinet number of the inverter unit. It is a real-time analog parameter. Value range: 0 to 30, and its value is an integer (1).
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwHWInverterUnitSetEntry 15 }

        hwHWInverterUnitOnOffControl OBJECT-TYPE
            SYNTAX INTEGER
                {
                on(1),
                off(2),
                nulloper(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Power-on or power-off of the inverter unit. It is an enumeration value:
                If the NMS notifies the SNMP agent that this node is set to 1, it indicates power-on of the inverter unit;
                If the NMS notifies the SNMP agent that this node is set to 2, it indicates power-off of the inverter unit.
                If the NMS notifies the SNMP agent that this node is set to 255, it indicates nullOper of the inverter unit."
            ::= { hwHWInverterUnitSetEntry 13 }

