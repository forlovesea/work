                hwLiBatteryCabinetIndex
                    Unsigned32,
                hwLiBatteryCabinetEquipId
                    Unsigned32,
                hwLiBatteryCabinetEquipName
                    OCTET STRING,
                hwLiBatteryCabinetBatteryTotalCurrent
                    Integer32,
                hwLiBatteryCabinetBMUTotalQuantity
                    Unsigned32,
                hwLiBatteryCabinetBMUOnlineQuantity
                    Unsigned32,
                hwLiBatteryCabinetBMUOfflineQuantity
                    Unsigned32
            }

        hwLiBatteryCabinetIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Li Battery Cabinet Index."
