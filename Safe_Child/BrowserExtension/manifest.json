{
  "manifest_version": 3,
  "name": "SafeChild 전달 메시지",
  "version": "1.0.0",
  "description": "차단된 사이트 접속 시 PC의 SafeChild 앱에 보호자의 메시지 표시를 요청합니다.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["webNavigation", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:47832" }
}
