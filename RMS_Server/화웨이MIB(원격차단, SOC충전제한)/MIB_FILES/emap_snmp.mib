            ::= { hwPVAdapterSampEntry 1 }

        hwPVAdapterEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter  device ID."
            ::= { hwPVAdapterSampEntry 2 }

        hwPVAdapterEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter  name, of the character string type, is used to specify PV Adapter .
                
                "
            ::= { hwPVAdapterSampEntry 3 }

        hwPVAdapterInputVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..5000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Input Voltage.
                Value range: 0.0 to 500.0, 
                resolution: 2V, 
                unit: V,
                and the value is accurate to one decimal place (.1), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 4 }

        hwPVAdapterOutputVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..2000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Output Voltage.
                Value range: 0.0 to 200.0, 
                resolution: 1V, 
                unit: V,
                and the value is accurate to one decimal place (.1), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 5 }

        hwPVAdapterOutputCurrent OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Output Current.
                Value range: 0 to 1000,   
                resolution: 0.5A, 
                unit: A,
                and the value is accurate to one decimal place (.1), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 6 }

        hwPVAdapterModuleAddress OBJECT-TYPE
            SYNTAX Unsigned32 (0..127)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Module Address.
                Value range: 0 to 127.   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 7 }

        hwPVAdapterPowerOnOffStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                powerOn(1), powerOff(2) 
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter On/Off Status. It is an enumeration type:  
                  If the enumeration value is 1, it indicates that the powerOn;
                  If the enumeration value is 2, it indicates that the powerOff."
            ::= { hwPVAdapterSampEntry 8 }

        hwPVAdapterSoftwareVersion OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Software Version, of the character string type. Signal value length is 5."
            ::= { hwPVAdapterSampEntry 9 }

        hwPVAdapterHardwareVersion OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Hardware Version, of the character string type. Signal value length is 5."
            ::= { hwPVAdapterSampEntry 10 }

        hwPVAdapterInputCurrent OBJECT-TYPE
            SYNTAX Unsigned32 (0..1270)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Input Current. Only present on photovoltaic adapters.
                Value range: 0 to 127.   
                resolution: 1A, 
                unit: A,
                and the value is accurate to one decimal place (.1), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 11 }

        hwPVAdapterTemperature OBJECT-TYPE
            SYNTAX Integer32 (-300..300)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Temperature. Only present on photovoltaic adapters.
                Value range: -300 to 300, 
                resolution: 1¡ãC, 
                unit: ¡ãC,
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 12 }

        hwPVAdapterStringNumber OBJECT-TYPE
            SYNTAX Unsigned32 (0..255)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter String No. Only present on photovoltaic adapters.
                Value range: 0 to 255.   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 13 }

        hwPVAdapterBarcode OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Barcode. Signal value length is 25."
            ::= { hwPVAdapterSampEntry 14 }

        hwPVAdapterPVLockEnableState OBJECT-TYPE
            SYNTAX INTEGER
                {
                lockFunctionOff(1), lockFunctionOn(2) 
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter PV Lock Enable State. Only present on photovoltaic adapters. It is an enumeration type: 
                  If the enumeration value is 1, it indicates that the LockFunctionOff;
                  If the enumeration value is 2, it indicates that the LockFunctionOn."
            ::= { hwPVAdapterSampEntry 15 }

        hwPVAdapterSTASoftwareVersion OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter STA Software Version, of the character string type. Only present on photovoltaic adapters. Signal value length is 5."
            ::= { hwPVAdapterSampEntry 16 }

        hwPVAdapterOutputPower OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Output Power.
                Value range: 0 to 100000, 
                resolution: 0.03kwh, 
                unit: kW,
                and the value is accurate to two decimal place (.01), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 17 }

        hwPVAdapterType OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter Type, of the character string type. Only present on photovoltaic adapters. Signal value length is 25."
            ::= { hwPVAdapterSampEntry 18 }

        hwPVAdapterPCUSlot OBJECT-TYPE
            SYNTAX Unsigned32 (1..9)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter PCU Slot. Only present on photovoltaic adapters.
                Value range: 1 to 9, 
                resolution: 1, 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 19 }

        hwPVAdapterSSUSlot OBJECT-TYPE
            SYNTAX Unsigned32 (1..65535)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "PV Adapter SSU Slot. Only present on photovoltaic adapters.
                Value range: 1 to 65535, 
                resolution: 1, 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwPVAdapterSampEntry 20 }

        hwSiteTankAbs OBJECT IDENTIFIER ::= { hwSiteMonitorMIBObjects 24 }

        hwSiteTankAbsEquip OBJECT-TYPE
            SYNTAX SEQUENCE OF HwSiteTankAbsEquipEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                ""
            ::= { hwSiteTankAbs 1 }

        hwSiteTankAbsEquipEntry OBJECT-TYPE
                        SYNTAX HwSiteTankAbsEquipEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                ""
            INDEX { hwTankAbsIndex }
            ::= { hwSiteTankAbsEquip 1 }

        HwSiteTankAbsEquipEntry            ::= SEQUENCE {
                hwTankAbsIndex
                    Unsigned32,
                hwTankAbsEquipId
                    Unsigned32,
                hwTankAbsEquipName
                    OCTET STRING,
                hwRemainingFuelGallon
                    Unsigned32,
                hwFuelLevel
                    Unsigned32,
                hwFuelViscosity
                    Unsigned32,
                hwFuelDensity
                    Unsigned32,
                hwFuelDielectricConstant
                    Unsigned32,
                hwFuelTemperature
                    Integer32
            }

        hwTankAbsIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "TankAbs table index,which value range:1 to 256. Lines of the device list are restricted by the quantity of TankAbs."
            ::= { hwSiteTankAbsEquipEntry 1 }

        hwTankAbsEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "TankAbs device ID. Value range: 027'001 to 027'255, in which the first digits indicate the device type and the last three digits indicate the device SN."
            ::= { hwSiteTankAbsEquipEntry 2 }

        hwTankAbsEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Device name of the TankAbs module, character string type, is used to specify the TankAbs module. Otherwise, the configured character can not be any other languages except English."
            ::= { hwSiteTankAbsEquipEntry 3 }

        hwRemainingFuelGallon OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "RemainingFuel.Value range: 0 to 100000, unit: Gal, and the value is two decimal space (.01). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 4 }

        hwFuelLevel OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "FuelLevel.Value range: 0 to 1000, unit: cm,  and the value is an integer (.0). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 5 }

        hwFuelViscosity OBJECT-TYPE
            SYNTAX Unsigned32 (50..5000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "FuelViscosity.Value range: 0.5 to 50, unit: mPa-s, and the value is two decimal space (.01). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 6 }

        hwFuelDensity OBJECT-TYPE
            SYNTAX Unsigned32 (650..1500)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "FuelDensity.Value range: 0.65 to 1.50, unit: gm/cc, and the value is three decimal space (.001). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 7 }

        hwFuelDielectricConstant OBJECT-TYPE
            SYNTAX Unsigned32 (100..600)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "FuelDielectricConstant.Value range: 1 to 6, unit: NA, and the value is two decimal space (.2). If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 8 }

        hwFuelTemperature OBJECT-TYPE
            SYNTAX Integer32 (-3000..10000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "FuelTemperature.Value range: -30 to 100, unit: degC, and the value is two decimal space (.01). . If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSiteTankAbsEquipEntry 9 }

