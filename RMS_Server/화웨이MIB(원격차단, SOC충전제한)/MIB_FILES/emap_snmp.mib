                    INTEGER
            }

        hwSSMBatVolt OBJECT-TYPE
            SYNTAX Unsigned32 (0..600)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "voltage of the battery. It indicates the real-time statistics of the battery on the site. 
                Value range: 0 to 60, 
                unit: V, 
                and the value is accurate to one decimal place (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 1 }

        hwSSMBatCurr OBJECT-TYPE
            SYNTAX Integer32 (-2000..2000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Current of the battery. It indicates the real-time statistics of the battery on the site. 
                Value range: -200 to 200, 
                unit: A, 
                and the value is accurate to one decimal place (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 2 }

        hwSSMRunningStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                offline(1),
                sleep(2),
                charge(3),
                discharge(4),
                standby(5),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Battery charging state, indicates the charging and discharging information about the battery group. It is an enumeration type. 
                If the enumeration value is 1, it indicates a battery is off line. 
                If the enumeration value is 2, it indicates a battery  is sleep. 
                If the enumeration value is 3, it indicates a battery  in the charge state.
                If the enumeration value is 4, it indicates a battery  in the discharge state.
                If the enumeration value is 5, it indicates a battery  in the standby state.
                If the enumeration value is 255, it indicates a battery group in the unknown state. "
            ::= { hwSSMSampEntry 3 }

        hwSSMBatSoh OBJECT-TYPE
            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Soh of the battery. It indicates the real-time statistics of the battery on the site. 
                Value range: 0 to 100, 
                unit: %, 
                and the value is accurate to one decimal place (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 4 }

        hwSSMBatCapacity OBJECT-TYPE
            SYNTAX Unsigned32 (0..100000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Capacity of the battery. It indicates the real-time statistics of the battery on the site. 
                Value range: 0 to 10000, 
                unit: Ah, 
                and the value is accurate to one decimal place (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 5 }

        hwSSMBatCell1Volt OBJECT-TYPE
            SYNTAX Unsigned32 (0..500)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Voltage of the battery cell. It indicates the real-time statistics of the battery on the site. 
                Value range: 0.00 to 5.00, 
                unit: V, 
                and the value is accurate to two decimal place (.01).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 6 }

        hwSSMBatCell2Volt OBJECT-TYPE
            SYNTAX Unsigned32 (0..500)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Voltage of the battery cell. It indicates the real-time statistics of the battery on the site. 
                Value range: 0.00 to 5.00, 
                unit: V, 
                and the value is accurate to two decimal place (.01).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 7 }

        hwSSMBatCell1Temp OBJECT-TYPE
            SYNTAX Integer32 (-500..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Temperature of the battery cell. It indicates the real-time statistics of the battery on the site. 
                Value range: -50.0 to 100.0, 
                unit: centigrade(degC), 
                and the value is accurate to one decimal place (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 8 }

        hwSSMBatCell2Temp OBJECT-TYPE
            SYNTAX Integer32 (-500..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Temperature of the battery cell. It indicates the real-time statistics of the battery on the site. 
                Value range: -50.0 to 100.0, 
                unit: centigrade(degC), 
                and the value is accurate to one decimal place (.1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 9 }

        hwSSMBatRemainCapacity OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The battery total remain capacity; Value range:0 to 100, 
                unit: %. 
                and the value is accurate to one decimal place (.1).   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 10 }

        hwSSMPVInputVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..350)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Input voltage of PV module."
            ::= { hwSSMSampEntry 11 }

        hwSSMPVInputCurrent OBJECT-TYPE
            SYNTAX Integer32 (-100..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Input current of the PV module."
            ::= { hwSSMSampEntry 12 }

        hwSSMPVTotalOutputPower OBJECT-TYPE
            SYNTAX Integer32 (0..100000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The PV output power; 
                Value range: 0 to 10000000.0, 
                and the value is accurate to two decimal place (.01), 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMSampEntry 13 }

        hwSSM12VOutputVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..160)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Output voltage of 12V port."
            ::= { hwSSMSampEntry 14 }

        hwSSM12VOutputCurrent OBJECT-TYPE
            SYNTAX Integer32 (-50..50)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Output current of 12V port."
            ::= { hwSSMSampEntry 15 }

        hwSSM12VOutputStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                off(1),
                start(2),
                running(3),
                unknown(65535)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "State of the 12V output state. It is an enumeration type: 
                  If the enumeration value is 0, it indicates that the 12V output is in the off state;
                  If the enumeration value is 1, it indicates that the 12V output is in the start state.
                  If the enumeration value is 2, it indicates that the 12V output is in the running state;
                  If the enumeration value is 0xffff, it indicates that the 12V output is in the unknown state."
            ::= { hwSSMSampEntry 16 }

