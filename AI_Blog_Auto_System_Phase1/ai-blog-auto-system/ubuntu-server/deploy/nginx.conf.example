# Include within nginx's http context. Replace the domain and TLS certificate paths.
map $http_upgrade $blog_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name blog-monitor.example.com;
    ssl_certificate /etc/letsencrypt/live/blog-monitor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blog-monitor.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;
    access_log off;
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $blog_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    location / { return 404; }
}
