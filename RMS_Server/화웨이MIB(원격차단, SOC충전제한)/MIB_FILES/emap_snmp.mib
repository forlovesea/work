        hwAcbSetTable OBJECT-TYPE
            SYNTAX SEQUENCE OF HwAcbSetEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            ::= { hwAcbEquip 3 }

        hwAcbSetEntry OBJECT-TYPE
                        SYNTAX HwAcbSetEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            INDEX { hwAcbCtlOnOff }
            ::= { hwAcbSetTable 1 }

        HwAcbSetEntry            ::= SEQUENCE {
                hwAcbCtlOnOff
                    INTEGER,
                hwAcbGyroEnable
                    INTEGER,
                hwAcbGyroSensitivityLevel
                    INTEGER,
                hwAcbVendorName
                    OCTET STRING,
                hwAcbManufactured
                    OCTET STRING,
                hwAcbSelfStaggerDOD
                    Unsigned32
            }

        hwAcbCtlOnOff OBJECT-TYPE
            SYNTAX INTEGER
                {
                on(1),
                off(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Control power on/off. It is an enumeration value, and users actively set it. If the enumeration value is 1, it means to power off; If the enumeration value is 2, it means to power on; If the enumeration value is 255, it indicates a battery group in the unknown state."
            ::= { hwAcbSetEntry 2 }

        hwAcbGyroEnable OBJECT-TYPE
            SYNTAX INTEGER
                {
                disable(0),
                enable(1),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Gyro Function Enable, 
                Restricted use in special areas. If the value of the device is within the range, but the setting fails, the function is not supported.
                It is an enumeration value: 
                If the enumeration value is 0, it means to gyro function disable,
                If the enumeration value is 1, it means to gyro function enable,
                If the enumeration value is 255, it indicates gyro in the unknown state."
            ::= { hwAcbSetEntry 5 }

        hwAcbGyroSensitivityLevel OBJECT-TYPE
            SYNTAX INTEGER
                {
                low(0),
                midium(1),
                high(2),
                unknown(255)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Gyro Level of Sensitivity.
                Restricted use in special areas. If the value of the device is within the range, but the setting fails, the function is not supported.
                It is an enumeration value:
                If the enumeration value is 0, it means to low sensitivity,
                If the enumeration value is 1, it means to medium sensitivity,
                If the enumeration value is 2, it means to high sensitivity,
                If the enumeration value is 255, it indicates gyro in the unknown level."
            ::= { hwAcbSetEntry 6 }

        hwAcbVendorName OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Battery vendor name,can be configured by users.
                "
            ::= { hwAcbSetEntry 7 }

        hwAcbManufactured OBJECT-TYPE
            SYNTAX OCTET STRING
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Battery manufacturing date,can be configured by users, and the setting style reference is YYYY-MM-DD."
            ::= { hwAcbSetEntry 8 }

        hwAcbSelfStaggerDOD OBJECT-TYPE
            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Self stagger DOD value of ACB battery. Value range: 0 to 100, unit: %, and the value is an interger. Default value is 50%."
            ::= { hwAcbSetEntry 9 }

