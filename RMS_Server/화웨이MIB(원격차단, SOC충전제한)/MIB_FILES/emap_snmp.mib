        hwIcbdLoadDisconnectReason OBJECT-TYPE
            SYNTAX INTEGER
                {
                connect(1),
                lowVoltDiscon(2),
                timeDisconnect(3),
                capacityDisconnect(4),
                highTempDisconnect(5),
                manualDisconnect(6),
                timedDisconnect(7),
                maintDisconnect(8),
                peakShavingDiscon(9),
                dinDisconnect(10),
                ldDiscon-EnergyCons(11),
                noBkupInExemptPeriod(12),
                unauthorizedDiscon(13),
                dgServiceNotPurchased(14),
                liBattOverloadDiscon(15),
                backupResReservDiscon(16),
                lowTempDiscon(17),
                ultraLowTempDiscon(18),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "State of the ICBD load disconnect reason.It is an enumeration type:
                If the enumeration value is 1, it indicates that load is connect,
                If the enumeration value is 2,it indicates that reason is LVD,
                If the enumeration value is 3, it indicates that reason is time disconnect,
                If the enumeration value is 4, , it indicates that reason is cap disconnect,
                If the enumeration value is 5, it indicates  that reason is HT disconnect,
                If the enumeration value is 6, it indicates  that reason is manual disconnect,
                If the enumeration value is 7, it indicates  that reason is timed disconnect,
                If the enumeration value is 8, it indicates  that reason is maintenance disconnect,
                If the enumeration value is 9, it indicates  that reason is peak shave disconnect,
                If the enumeration value is 10, it indicates  that reason is DIN disconnect,
                If the enumeration value is 11, it indicates  that reason is LdDiscon-EnergyCons,
                If the enumeration value is 12, it indicates  that reason is NoBkupInExemptPeriod,
                If the enumeration value is 13, it indicates  that reason is UnauthorizedDiscon,
                If the enumeration value is 14, it indicates  that reason is DGServiceNotPurchased,
                If the enumeration value is 15, it indicates  that reason is LiBattOverloadDiscon,
                If the enumeration value is 16, it indicates  that reason is BackupResReservDiscon,
                If the enumeration value is 17, it indicates  that reason is LowTempDiscon,
                If the enumeration value is 18, it indicates  that reason is UltraLowTempDiscon,
                If the enumeration value is 255, that battery operation status unknown."
            ::= { hwIcbdLoadSampEntry 10 }

        hwIcbdLoadDcVolt OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "IDBD load DC voltage. It is an analog parameter collected by the IDBD load in real time. Value range: 0 to 100, unit: V, and the value is accurate to one decimal place (.1).  If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwIcbdLoadSampEntry 11 }

        hwIcbdLoadTemperature OBJECT-TYPE
            SYNTAX Integer32 (-1000..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "ICBD load temperature. 
                Value range:-100 to 100£¬unit: ¡æ, the value is accurate to one decimal space (.1). "
            ::= { hwIcbdLoadSampEntry 12 }

