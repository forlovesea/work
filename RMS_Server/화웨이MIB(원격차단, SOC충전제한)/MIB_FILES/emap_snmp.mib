            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The battery total remain capacity; Value range:0 to 100, 
                unit: %. 
                and the value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMGroupSampEntry 10 }

        hwSSMGroupTemperature OBJECT-TYPE
            SYNTAX Integer32 (-50..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The battery temperature; Value range:50 to 100, 
                unit: degC. 
                and the value is an integer (1).  
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMGroupSampEntry 11 }

        hwSSMGroupTotalDisChargePower OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000000000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The battery total dicharge power; Value range:0 to 1000000000, 
                unit: wh. 
                and the value is accurate to three decimal place (.001).   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMGroupSampEntry 12 }

        hwSSMGroupEsmuCommNum OBJECT-TYPE
            SYNTAX Unsigned32 (0..100)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The esmu communicate number; 
                Value range: 0 to 100.   
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwSSMGroupSampEntry 13 }

