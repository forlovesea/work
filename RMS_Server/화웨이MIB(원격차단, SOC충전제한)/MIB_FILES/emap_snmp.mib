                Value range: close is 1, open is 2."
            ::= { hwThirdPartyLitBatSampEntry 9 }

        hw3rdPartyBatCurrLimitStatus OBJECT-TYPE
            SYNTAX INTEGER
                {
                limitCurrent(1),
                currentNotLimited(2),
                unknown(255)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Third-party lithium battery current limiting status,lithium battery types include ZTT. 
                Value range: limit current is 1,current not limited is 2, ."
