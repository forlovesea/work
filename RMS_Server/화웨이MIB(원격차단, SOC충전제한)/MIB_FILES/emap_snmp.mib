        hwThirdPartyAcMeters OBJECT IDENTIFIER ::= { hwSiteMonitorMIBObjects 60 }

        hwThirdPartyAcMeterEquip OBJECT IDENTIFIER ::= { hwThirdPartyAcMeters 1 }

        hwThirdPartyAcMeterSampTable OBJECT-TYPE
            SYNTAX SEQUENCE OF HwThirdPartyAcMeterSampEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            ::= { hwThirdPartyAcMeterEquip 1 }

        hwThirdPartyAcMeterSampEntry OBJECT-TYPE
                        SYNTAX HwThirdPartyAcMeterSampEntry
            MAX-ACCESS not-accessible
             STATUS current
             DESCRIPTION
                "/"
            INDEX { hwThirdPartyAcMeterIndex }
            ::= { hwThirdPartyAcMeterSampTable 1 }

        HwThirdPartyAcMeterSampEntry            ::= SEQUENCE {
                hwThirdPartyAcMeterIndex
                    Unsigned32,
                hwThirdPartyAcMeterEquipId
                    Unsigned32,
                hwThirdPartyAcMeterEquipName
                    OCTET STRING,
                hwThirdPartyAcMeterFrequency
                    Unsigned32,
                hwThirdPartyAcMeterPhaseAVoltage
                    Unsigned32,
                hwThirdPartyAcMeterPhaseBVoltage
                    Unsigned32,
                hwThirdPartyAcMeterPhaseCVoltage
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL1Current
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL2Current
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL3Current
                    Unsigned32,
                hwThirdPartyAcMeterAPowerFactor
                    Unsigned32,
                hwThirdPartyAcMeterBPowerFactor
                    Unsigned32,
                hwThirdPartyAcMeterCPowerFactor
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL1ReactivePower
                    Integer32,
                hwThirdPartyAcMeterPhaseL2ReactivePower
                    Integer32,
                hwThirdPartyAcMeterPhaseL3ReactivePower
                    Integer32,
                hwThirdPartyAcMeterTotalReactivePower
                    Integer32,
                hwThirdPartyAcMeterPhaseL1ActivePower
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL2ActivePower
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL3ActivePower
                    Unsigned32,
                hwThirdPartyAcMeterTotalActivePower
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL1ApparentPower
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL2ApparentPower
                    Unsigned32,
                hwThirdPartyAcMeterPhaseL3ApparentPower
                    Unsigned32,
                hwThirdPartyAcMeterTotalApparentPower
                    Unsigned32,
                hwThirdPartyAcMeterExportedReactiveEnergy
                    Unsigned32,
                hwThirdPartyAcMeterImportedReactiveEnergy
                    Unsigned32,
                hwThirdPartyAcMeterTotalReactiveEnergy
                    Unsigned32,
                hwThirdPartyAcMeterExportedActiveEnergy
                    Unsigned32,
                hwThirdPartyAcMeterImportedActiveEnergy
                    Unsigned32,
                hwThirdPartyAcMeterTotalActiveEnergy
                    Unsigned32
            }

        hwThirdPartyAcMeterIndex OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter table index,which value range:4096 to 20479. Lines of the device list are restricted by the quantity of AcAmmeter"
            ::= { hwThirdPartyAcMeterSampEntry 1 }

        hwThirdPartyAcMeterEquipId OBJECT-TYPE
            SYNTAX Unsigned32
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter device ID. Value range: 022'001 to 022'255, in which the first digits indicate the device type and the last three digits indicate the device SN."
            ::= { hwThirdPartyAcMeterSampEntry 2 }

        hwThirdPartyAcMeterEquipName OBJECT-TYPE
            SYNTAX OCTET STRING (SIZE (0..63))
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter name, of the character string type, is used to specify Fans. Users can configure it.
                Otherwise, the configured character can not be any other languages except English."
            ::= { hwThirdPartyAcMeterSampEntry 3 }

        hwThirdPartyAcMeterFrequency OBJECT-TYPE
            SYNTAX Unsigned32 (0..10000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter frequency, 
                Value range: 0.00 to 100.00.
                Unit: Hz.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 4 }

        hwThirdPartyAcMeterPhaseAVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..8000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase a voltage. It is a real-time analog parameter. 
                Value range: 0.0 to 800.0, 
                unit: V, 
                the value is accurate to one decimal place (.1). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. "
            ::= { hwThirdPartyAcMeterSampEntry 5 }

        hwThirdPartyAcMeterPhaseBVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..8000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase b voltage. It is a real-time analog parameter. 
                Value range: 0.0 to 800.0, 
                unit: V, 
                the value is accurate to one decimal place (.1). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. "
            ::= { hwThirdPartyAcMeterSampEntry 6 }

        hwThirdPartyAcMeterPhaseCVoltage OBJECT-TYPE
            SYNTAX Unsigned32 (0..8000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase c voltage. It is a real-time analog parameter. 
                Value range: 0.0 to 800.0, 
                unit: V, 
                the value is accurate to one decimal place (.1). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid. "
            ::= { hwThirdPartyAcMeterSampEntry 7 }

        hwThirdPartyAcMeterPhaseL1Current OBJECT-TYPE
            SYNTAX Unsigned32 (0..50000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase a current, 
                Value range: 0.00 to 500.00.
                Unit: A.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 8 }

        hwThirdPartyAcMeterPhaseL2Current OBJECT-TYPE
            SYNTAX Unsigned32 (0..50000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase b current, 
                Value range: 0.00 to 500.00.
                Unit: A.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 9 }

        hwThirdPartyAcMeterPhaseL3Current OBJECT-TYPE
            SYNTAX Unsigned32 (0..50000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase c current, 
                Value range: 0.00 to 500.00.
                Unit: A.
                and the value is accurate to two decimal space (.01). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 10 }

        hwThirdPartyAcMeterAPowerFactor OBJECT-TYPE
            SYNTAX Unsigned32 (-1000..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase a power factor, 
                Value range: -1.000 to 1.000.
                and the value is accurate to three decimal space (.001). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 11 }

        hwThirdPartyAcMeterBPowerFactor OBJECT-TYPE
            SYNTAX Unsigned32 (-1000..1000)
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Ac Ammeter phase a power factor, 
                Value range: -1.000 to 1.000.
                and the value is accurate to three decimal space (.001). 
                If the value is 2147483647(0x7FFFFFFF), it indicates that the value is invalid."
            ::= { hwThirdPartyAcMeterSampEntry 12 }

