DB_PATH=/var/lib/moa/meetings.db
VOSK_MODEL_PATH=/var/lib/moa/models/vosk-model-small-ko-0.22
SPEECH_ENGINE=vosk
WHISPER_MODEL_PATH=/var/lib/moa/models/faster-whisper-small
# Optional glossary only, not sentences to insert into the minutes.
WHISPER_PROMPT=
MAX_PARTICIPANTS=8
MAX_ROOMS=30
# Required for Master-approved room creation. Existing room joins remain available.
PUBLIC_BASE_URL=https://61.105.141.21:10443
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALLOWED_ORIGINS=
ICE_SERVERS_JSON=[]
# systemd EnvironmentFile syntax: quote the WHOLE JSON value with single quotes.
# ICE_SERVERS_JSON='[{"urls":"turn:meet.example.com:3478?transport=udp","username":"meeting","credential":"CHANGE_ME"}]'
